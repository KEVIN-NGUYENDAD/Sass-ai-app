# Gmail Configuration
# Create App Password at: https://myaccount.google.com/apppasswords
# (Must have 2-Step Verification enabled)

# Your Gmail address
GMAIL_ADDRESS=your_email@gmail.com

# Gmail App Password (16 characters, no spaces)
# Get from: https://myaccount.google.com/apppasswords
# Format: xxxx xxxx xxxx xxxx (with spaces as shown)
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Email recipient (can be same as GMAIL_ADDRESS)
RECIPIENT_EMAIL=your_email@gmail.com

# Optional: For multiple recipients, separate with comma
# RECIPIENT_EMAIL=email1@example.com,email2@example.com
